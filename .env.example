OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_REASONING_EFFORT=high

# Dedicated inbox (IMAP + app password). Newsletters are forwarded here;
# the app pulls matching From addresses on a daily schedule (and on Sync now).
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
# Only ingest messages whose From contains one of these (comma-separated).
IMAP_ALLOWED_FROM=zainab.abaid@emumba.com
IMAP_SYNC_ENABLED=1
# Local hour (0-23) for the daily pull while the API is running.
IMAP_SYNC_HOUR=6
