OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_REASONING_EFFORT=high

# Dedicated inbox (IMAP + app password). Newsletters are forwarded here.
# Daily sync and Sync inbox now pull matches. AI search does not.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
# Comma-separated addresses. A message matches if one appears in From, To, Cc,
# or the Gmail forward headers. Auto-forward keeps the newsletter's original From.
IMAP_ALLOWED_FROM=zainab.abaid@emumba.com
IMAP_SYNC_ENABLED=1
# Hour 0-23 on the API process clock. Railway containers use UTC.
IMAP_SYNC_HOUR=6

# Role tokens (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
# If VIEWER_TOKEN is set, the app stays locked until a valid token is entered.
# Leave VIEWER_TOKEN empty only for open local-only use.
# Prefer host secrets / env vars in production — never commit real tokens.
VIEWER_TOKEN=
ANALYST_TOKEN=
ADMIN_TOKEN=
